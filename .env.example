# Node backend configuration. No API key required.
LLAMA_BASE_URL=http://127.0.0.1:8080
API_PORT=3001
CONTEXT_LIMIT=8192
DATABASE_PATH=data/shiori.sqlite

# Optional local TTS. POST JSON {text, voice, speed} and expect an audio/* response.
# TTS_URL=http://127.0.0.1:9880/tts

# Optional web search via a local MCP server (Streamable HTTP). Set to off to disable.
# MCP_SEARCH_URL=http://127.0.0.1:8081/mcp
